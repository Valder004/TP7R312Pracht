---
import Layout from "../../../layouts/Layout.astro";
import PlotFigure from "../../../components/PlotFigure.astro";
import penguins from "../../../assets/penguins.json";

export function getStaticPaths() {
  const sexes = [...new Set(penguins.map((penguin) => penguin.sex))]
    .filter((sex): sex is string => typeof sex === "string" && sex.length > 0);
  return sexes.map((item) => ({ params: { sex: item } }));
}

const sex = Astro.params.sex;
const data = penguins.filter((penguin) => penguin.sex === sex);
---

<Layout title={`Manchots ${sex}`}>
  <header class="page-intro">
    <p class="eyebrow">{String(data.length).padStart(3, "0")} observations</p>
    <h1><em>{sex}</em></h1>
    <p><a class="text-link" href="/penguins/sex/">Tous les sexes</a></p>
  </header>
  <section class="species-charts">
    <article class="chart-card"><h2>Bec et masse corporelle</h2><PlotFigure category="sex" value={sex} type="mass" /></article>
    <article class="chart-card"><h2>Distribution de la masse par espèce</h2><PlotFigure category="sex" value={sex} type="flipper" /></article>
    <article class="chart-card"><h2>Observations par île</h2><PlotFigure category="sex" value={sex} type="bill" /></article>
  </section>
</Layout>
