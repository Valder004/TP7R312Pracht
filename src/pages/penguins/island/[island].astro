---
import Layout from "../../../layouts/Layout.astro";
import PlotFigure from "../../../components/PlotFigure.astro";
import penguins from "../../../assets/penguins.json";

export function getStaticPaths() {
  const islands = [...new Set(penguins.map((penguin) => penguin.island))];
  return islands.map((item) => ({ params: { island: item } }));
}

const island = Astro.params.island;
const data = penguins.filter((penguin) => penguin.island === island);
---

<Layout title={`Manchots de ${island}`}>
  <header class="page-intro">
    <p class="eyebrow">{String(data.length).padStart(3, "0")} observations</p>
    <h1>Île <em>{island}</em></h1>
    <p><a class="text-link" href="/penguins/island/">← Toutes les îles</a></p>
  </header>
  <section class="species-charts">
    <article class="chart-card"><h2>Bec et masse corporelle</h2><PlotFigure category="island" value={island} type="mass" /></article>
    <article class="chart-card"><h2>Distribution de la masse par sexe</h2><PlotFigure category="island" value={island} type="flipper" /></article>
    <article class="chart-card"><h2>Observations par espèce</h2><PlotFigure category="island" value={island} type="bill" /></article>
  </section>
</Layout>
