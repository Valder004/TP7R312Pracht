---
import Layout from "../../layouts/Layout.astro";
import PlotFigure from "../../components/PlotFigure.astro";
---

<Layout title="Chinstrap">
  <header class="species-heading species-blue"><span>03</span><h1>Chinstrap</h1></header>
  <section class="species-charts">
    <article class="chart-card"><h2>Bec et masse</h2><PlotFigure species="Chinstrap" type="mass" /></article>
    <article class="chart-card"><h2>Distribution de la masse</h2><PlotFigure species="Chinstrap" type="flipper" /></article>
    <article class="chart-card"><h2>Observations par île</h2><PlotFigure species="Chinstrap" type="bill" /></article>
  </section>
</Layout>

